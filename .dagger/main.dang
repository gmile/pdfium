let repositoryUrl = "https://github.com/gmile/pdfium"
let repositorySlug = "gmile/pdfium"
let libpdfiumBinariesUrl = "https://github.com/bblanchon/pdfium-binaries"
let alpineImage = "alpine:3.24.3"
let images: Map[String!]! = ["glibc": "hexpm/elixir:1.20.5-erlang-29.1.2-ubuntu-noble-20261024.1", "musl": "hexpm/elixir:1.20.5-erlang-29.1.2-alpine-3.24.3"]
let zigVersion = "0.17.1"
let zigTargets: Map[String!]! = [
  "aarch64-linux-gnu": "aarch64-linux-gnu.2.17", "aarch64-linux-musl": "aarch64-linux-musl",
  "x86_64-linux-gnu": "x86_64-linux-gnu.2.17", "x86_64-linux-musl": "x86_64-linux-musl",
  "aarch64-apple-darwin": "aarch64-macos", "x86_64-apple-darwin": "x86_64-macos",
]
let archives: Map[String!]! = [
  "aarch64-linux-gnu": "linux-arm64", "aarch64-linux-musl": "linux-musl-arm64",
  "x86_64-linux-gnu": "linux-x64", "x86_64-linux-musl": "linux-musl-x64",
  "aarch64-apple-darwin": "mac-arm64", "x86_64-apple-darwin": "mac-x64",
]
let nifVersion = "2.18"
let packagePaths: [String!]! = ["build.zig", "build.zig.zon", "build/**", "c_src/**", "lib/**", "LICENSE", "mix.exs", "mix.lock", "README.md", "VERSION"]
let testPaths: [String!]! = packagePaths + ["test/**"]

type Pdfium {
  pub prepareRelease(actor: String!): Bump! {
    let main = git(url: repositoryUrl).branch("main")
    let tree = main.tree
    let tag = latestLibpdfiumTag
    let version = nextPatchVersion(tree)
    let manifest = archives.keys.reduce(buildImage.withFile("/src/build.zig", tree.file("build.zig")).withFile("/src/build.zig.zon", tree.file("build.zig.zon")).withWorkdir("/src")) { acc, target =>
      acc.withExec(["zig", "fetch", `--save=pdfium_${target}`, archiveUrl(tag, target)])
    }
    let withTag = tree.withFile("build.zig.zon", manifest.file("/src/build.zig.zon"))
    let withVersion = withTag.withNewFile("VERSION", version)
    let first = commit(main, withTag.changes(tree), `Update libpdfium to ${tag}`, actor)

    Bump(ref: commit(first, withVersion.changes(withTag), `Update package to version ${version}`, actor))
  }

  pub precompile(srcDir: Directory!, target: String!): File! {
    let packageVersion = srcDir.file("VERSION").contents
    let outputPath = `/build/pdfium-nif-${nifVersion}-${target}-${packageVersion}.tar.gz`
    let library = if (darwin(target)) "libpdfium.dylib" else "libpdfium.so"

    buildImage
      .withFile("/src/build.zig", srcDir.file("build.zig"))
      .withFile("/src/build.zig.zon", srcDir.file("build.zig.zon"))
      .withWorkdir("/src")
      .withExec(["zig", "build", "--help"])
      .withDirectory("/src", srcDir)
      .withExec(["zig", "build", `-Dtarget=${zigTargets[target]!}`, "-Doptimize=ReleaseFast", "-Derts=/usr/local/lib/erlang/usr/include", "--prefix", "/build"])
      .withExec(["tar", "--create", "--verbose", `--file=${outputPath}`, "--directory", "/build", "pdfium_nif.so", library])
      .file(outputPath)
  }

  pub test(precompiled: File!, srcDir: Directory!, target: String!): File! {
    testImage(target)
      .withDirectory("/pdfium", srcDir)
      .withDirectory("/pdfium/priv", precompiled.extract)
      .withWorkdir("/pdfium")
      .withExec(["mix", "local.hex", "--force"])
      .withExec(["mix", "deps.get"])
      .withExec(["mix", "test"])
      .sync
    precompiled
  }

  pub ci(ws: Workspace!, target: String!): File! {
    let srcDir = ws.directory(".", include: testPaths)
    let archive = precompile(srcDir, target)

    if (darwin(target)) archive else test(archive, srcDir, target)
  }

  pub arm64LinuxGnu(ws: Workspace!): Void @check { ci(ws, "aarch64-linux-gnu").sync; null }
  pub arm64LinuxMusl(ws: Workspace!): Void @check { ci(ws, "aarch64-linux-musl").sync; null }
  pub arm64AppleDarwin(ws: Workspace!): Void @check { ci(ws, "aarch64-apple-darwin").sync; null }
  pub amd64LinuxGnu(ws: Workspace!): Void @check { ci(ws, "x86_64-linux-gnu").sync; null }
  pub amd64LinuxMusl(ws: Workspace!): Void @check { ci(ws, "x86_64-linux-musl").sync; null }
  pub amd64AppleDarwin(ws: Workspace!): Void @check { ci(ws, "x86_64-apple-darwin").sync; null }

  pub githubRelease(ws: Workspace!, artifacts: Directory!, sha: String!, githubToken: Secret!): Release! {
    let package = ws.directory(".", include: packagePaths)
    let version = package.file("VERSION").contents
    let assets = artifacts.entries.map { item => `/artifacts/${item}` }

    Release(
      package: package,
      receipt: gh(githubToken)
        .withDirectory("/artifacts", artifacts)
        .withExec(
          ["gh", "release", "create", `v${version}`, "--repo", repositorySlug, "--target", sha, "--title", `v${version}`] + assets,
          redirectStdout: "/receipt",
        )
        .file("/receipt"),
    )
  }
}

type Bump {
  pub ref: GitRef!

  pub openPullRequest(githubToken: Secret!): Container! {
    gh(githubToken)
      .withDirectory("/pdfium", ref.tree(depth: 0))
      .withWorkdir("/pdfium")
      .withExec(["gh", "auth", "setup-git"])
      .withExec(["git", "push", repositoryUrl, "HEAD:refs/heads/update-libpdfium"])
      .withExec(["gh", "pr", "create", "--repo", repositorySlug, "--base", "main", "--head", "update-libpdfium", "--reviewer", "gmile", "--fill-first"])
  }
}

type Release {
  pub package: Directory!
  pub receipt: File!

  pub hexPublish(hexApiKey: Secret!): Container! {
    container
      .from(images["musl"]!)
      .withDirectory("/pdfium", package)
      .withFile("/pdfium/release", receipt)
      .withWorkdir("/pdfium")
      .withExec(["mix", "local.hex", "--force"])
      .withExec(["mix", "deps.get"])
      .withExec(["mix", "elixir_make.checksum", "--all"])
      .withSecretVariable("HEX_API_KEY", hexApiKey)
      .withExec(["mix", "hex.publish", "package", "--yes"])
  }
}

let commit(ref: GitRef!, changes: Changeset!, message: String!, actor: String!): GitRef! {
  ref.withCommit(changes, message, currentTimestamp, actor, `${actor}@users.noreply.github.com`)
}

let gh(githubToken: Secret!): Container! {
  container
    .from(alpineImage)
    .withExec(["apk", "add", "git", "github-cli"])
    .withSecretVariable("GH_TOKEN", githubToken)
}

let darwin(target: String!): Boolean! {
  target.hasSuffix("apple-darwin")
}

let platform(target: String!): Platform! {
  (if (target.hasPrefix("aarch64")) "linux/arm64" else "linux/amd64") :: Platform!
}

let image(target: String!): String! {
  images[if (target.hasSuffix("musl")) "musl" else "glibc"]!
}

let testImage(target: String!): Container! {
  let base = container(platform: platform(target)).from(image(target))
  let cacerts = "/etc/ssl/certs/ca-certificates.crt"

  if (target.hasSuffix("gnu")) base.withFile(cacerts, container.from(images["musl"]!).file(cacerts)) else base
}

let buildImage: Container! {
  let arch = ["linux/arm64": "aarch64", "linux/amd64": "x86_64"][defaultPlatform :: String!]!
  let zig = `zig-${arch}-linux-${zigVersion}`

  container
    .from(images["musl"]!)
    .withExec(["apk", "add", "llvm", "tar"])
    .withDirectory("/zig", http(url: `https://ziglang.org/download/${zigVersion}/${zig}.tar.xz`).extract.directory(zig))
    .withEnvVariable("PATH", "/zig:${PATH}", expand: true)
}

let nextPatchVersion(tree: Directory!): String! {
  let parts = tree.file("VERSION").contents.split(".")
  `${parts[0]!}.${parts[1]!}.${(JSON.decode(parts[2]!) :: Int!) + 1}`
}

let latestLibpdfiumTag: String! {
  git(url: libpdfiumBinariesUrl)
    .tags(patterns: ["chromium/*"])
    .reduce("chromium/0") { acc, tag => if (tagNumber(tag) > tagNumber(acc)) tag else acc }
}

let archiveUrl(tag: String!, target: String!): String! {
  `${libpdfiumBinariesUrl}/releases/download/${tag.replace("/", "%2F")}/pdfium-${archives[target]!}.tgz`
}

let tagNumber(tag: String!): Int! {
  JSON.decode(tag.trimPrefix("chromium/")) :: Int!
}
