"""
Dagger automation for building, testing, and releasing pdfium.
"""
type Pdfium {
  type BuildInfo {
    pub buildImageName: String!
    pub pdfiumDownloadUrl: String!
    pub outputFilename: String!
  }

  let repositorySlug: String! {
    "gmile/pdfium"
  }

  let repositoryURL: String! {
    "https://github.com/gmile/pdfium"
  }

  let pdfiumBinariesURL: String! {
    "https://github.com/bblanchon/pdfium-binaries"
  }

  let fineURL: String! {
    "https://github.com/elixir-nx/fine"
  }

  let fineTag: String! {
    "v0.1.6"
  }

  let alpineImage: String! {
    "alpine:3.23.4"
  }

  let glibcImage: String! {
    "hexpm/elixir:1.20.1-erlang-29.0.2-ubuntu-resolute-20260421"
  }

  let muslImage: String! {
    "hexpm/elixir:1.20.1-erlang-29.0.2-alpine-3.23.4"
  }

  let nifVersion: String! {
    "2.17"
  }

  """
  Check whether bblanchon's pdfium-binaries project has a newer Chromium tag.
  """
  pub checkLatestTag(githubToken: Secret!): String! {
    let knownTag = sourceTree("stable", githubToken).file("LIBPDFIUM_TAG").contents.trimSpace
    let latestTag = latestLibpdfiumTag

    if (latestTag > knownTag) {
      "{\"new_tag_available\":true,\"tag\":" + toJSON(latestTag) + "}"
    } else {
      "{\"new_tag_available\":false}"
    }
  }

  """
  Open a release preparation pull request for a libpdfium tag and package version.
  """
  pub prepareReleasePullRequest(
    base: String!,
    packageVersion: String,
    libpdfiumTag: String,
    githubToken: Secret!,
    actor: String!,
  ): Container! {
    let srcDir = sourceTree(base, githubToken)
    let resolvedPackageVersion = if (packageVersion == null) {
      nextPatchVersion(srcDir.file("VERSION").contents.trimSpace)
    } else {
      packageVersion
    }
    let resolvedLibpdfiumTag = if (libpdfiumTag == null) {
      latestLibpdfiumTag
    } else {
      libpdfiumTag
    }
    let branchName = "update-libpdfium-to-" + resolvedLibpdfiumTag

    githubCLI(githubToken)
      .withDirectory("/pdfium", sourceTreeWithGit(base, githubToken))
      .withWorkdir("/pdfium")
      .withEnvVariable("ACTOR", actor)
      .withExec(["gh", "auth", "setup-git"])
      .withExec(["git", "switch", "--create", branchName])
      .withExec(["git", "config", "user.name", actor])
      .withExec(["git", "config", "user.email", actor + "@users.noreply.github.com"])
      .withNewFile("/pdfium/LIBPDFIUM_TAG", resolvedLibpdfiumTag)
      .withExec(["git", "add", "LIBPDFIUM_TAG"])
      .withExec(["git", "commit", "--message", "Update libpdfium tag to " + resolvedLibpdfiumTag])
      .withNewFile("/pdfium/VERSION", resolvedPackageVersion)
      .withExec(["git", "add", "VERSION"])
      .withExec(["git", "commit", "--message", "Update package to version " + resolvedPackageVersion])
      .withExec(["git", "push", "origin", branchName])
      .withExec([
        "gh",
        "pr",
        "create",
        "--base",
        base,
        "--reviewer",
        "gmile",
        "--fill",
        "--repo",
        repositorySlug,
        "--title",
        "Bump libpdfium to " + resolvedLibpdfiumTag + " tag",
      ])
  }

  let collectBuildInfo(srcDir: Directory!, platformName: String!, abi: String!): BuildInfo! {
    let erlangPlatformName = if (platformName == "linux/arm64") {
      "aarch64"
    } else if (platformName == "linux/amd64") {
      "x86_64"
    } else {
      raise "unsupported platform: " + platformName
    }

    let pdfiumPlatformName = if (platformName == "linux/arm64") {
      "arm64"
    } else if (platformName == "linux/amd64") {
      "x64"
    } else {
      raise "unsupported platform: " + platformName
    }

    let erlangAbiName = if (abi == "glibc") {
      "linux-gnu"
    } else if (abi == "musl") {
      "linux-musl"
    } else {
      raise "unsupported abi: " + abi
    }

    let pdfiumAbiName = if (abi == "glibc") {
      "linux"
    } else if (abi == "musl") {
      "linux-musl"
    } else {
      raise "unsupported abi: " + abi
    }

    let buildImageName = if (abi == "glibc") {
      glibcImage
    } else if (abi == "musl") {
      muslImage
    } else {
      raise "unsupported abi: " + abi
    }

    let pdfiumTag = srcDir.file("LIBPDFIUM_TAG").contents.trimSpace
    let encodedPdfiumTag = pdfiumTag.replace("/", "%2F")
    let packageVersion = srcDir.file("VERSION").contents.trimSpace

    BuildInfo {
      buildImageName: buildImageName,
      pdfiumDownloadUrl: "https://github.com/bblanchon/pdfium-binaries/releases/download/" + encodedPdfiumTag + "/pdfium-" + pdfiumAbiName + "-" + pdfiumPlatformName + ".tgz",
      outputFilename: "pdfium-nif-" + nifVersion + "-" + erlangPlatformName + "-" + erlangAbiName + "-" + packageVersion + ".tar.gz",
    }
  }

  """
  Build a precompiled pdfium NIF archive for one platform and ABI.
  """
  pub precompile(srcDir: Directory!, platformName: String!, abi: String!): File! {
    let info = collectBuildInfo(srcDir, platformName, abi)
    let otpDirectoryName = "/usr/local/lib/erlang"
    let libpdfiumExtractPath = "/pdfium"
    let fineIncludePath = "/fine"
    let outputPath = "/build/" + info.outputFilename
    let fineHeaders = git(url: fineURL).tag(fineTag).tree.directory("c_include")

    let compile = [
      "g++",
      "-march=native",
      "-Wall",
      "-Wextra",
      "-Werror",
      "-Wno-unused-parameter",
      "--pic",
      "-fvisibility=hidden",
      "--optimize=2",
      "--std=c++17",
      "--include-directory=" + otpDirectoryName + "/usr/include",
      "--include-directory=" + libpdfiumExtractPath + "/include",
      "--include-directory=" + fineIncludePath,
      "--compile",
      "--output=pdfium_nif.o",
      "pdfium_nif.cpp",
    ]

    let link = [
      "g++",
      "pdfium_nif.o",
      "--shared",
      "--output=pdfium_nif.so",
      "--library-directory=" + otpDirectoryName + "/usr/lib",
      "--library-directory=" + libpdfiumExtractPath + "/lib",
      "-static-libstdc++",
      "-Wl,-s",
      "-Wl,--disable-new-dtags",
      "-Wl,-rpath,$ORIGIN",
      "-l:libpdfium.so",
    ]

    let pack = [
      "tar",
      "--create",
      "--verbose",
      "--file=" + outputPath,
      "--directory",
      "/build",
      "pdfium_nif.so",
      "--directory",
      libpdfiumExtractPath + "/lib",
      "libpdfium.so",
    ]

    withBuildTools(container(platform: platformName).from(info.buildImageName), abi)
      .withWorkdir("/build")
      .withFile("/build/pdfium_nif.cpp", srcDir.file("c_src/pdfium_nif.cpp"))
      .withDirectory(fineIncludePath, fineHeaders)
      .withFile("/build/pdfium.tar", http(url: info.pdfiumDownloadUrl))
      .withExec(["mkdir", libpdfiumExtractPath])
      .withExec(["tar", "--extract", "--gunzip", "--directory=" + libpdfiumExtractPath, "--file=/build/pdfium.tar"])
      .withExec(compile)
      .withExec(link)
      .withExec(pack)
      .file(outputPath)
  }

  """
  Test a precompiled pdfium NIF archive.
  """
  pub test(precompiled: File!, platformName: String!, abi: String!): File! {
    let precompiledPath = "/test/" + precompiled.name

    withTestImage(platformName, abi)
      .withWorkdir("/test")
      .withFile(precompiledPath, precompiled)
      .withExec(["tar", "--extract", "--directory=/test/", "--file=" + precompiledPath])
      .withNewFile("/test/test.exs", testScript)
      .withNewFile("/test/test.pdf", testPdf)
      .withExec(["elixir", "test.exs"])
      .file(precompiledPath)
  }

  """
  Build and test a git ref from gmile/pdfium.
  """
  pub ci(ref: String!, platformName: String!, abi: String!, githubToken: Secret!): File! {
    test(precompile(sourceTree(ref, githubToken), platformName, abi), platformName, abi)
  }

  """
  Create a GitHub release from the successful CI artifacts for a pull request.
  """
  pub createRelease(pr: String!, actor: String!, githubToken: Secret!, hexApiKey: Secret!): Container! {
    let headRef = githubCLI(githubToken)
      .withExec(["gh", "pr", "view", pr, "--json", "headRefOid", "--jq", ".headRefOid", "--repo", repositorySlug])
      .stdout
      .trimSpace
    let baseRefName = githubCLI(githubToken)
      .withExec(["gh", "pr", "view", pr, "--json", "baseRefName", "--jq", ".baseRefName", "--repo", repositorySlug])
      .stdout
      .trimSpace
    let runID = githubCLI(githubToken)
      .withExec([
        "gh",
        "run",
        "list",
        "--workflow",
        "ci.yaml",
        "--commit",
        headRef,
        "--status",
        "success",
        "--limit",
        "1",
        "--json",
        "databaseId",
        "--repo",
        repositorySlug,
        "--jq",
        ".[0].databaseId",
      ])
      .stdout
      .trimSpace
    let packageVersion = sourceTree(baseRefName, githubToken).file("VERSION").contents.trimSpace

    container
      .from(muslImage)
      .withExec(["apk", "add", "git", "github-cli", "coreutils", "perl-utils"])
      .withDirectory("/pdfium", sourceTreeWithGit(baseRefName, githubToken))
      .withWorkdir("/pdfium")
      .withSecretVariable("GH_TOKEN", githubToken)
      .withSecretVariable("GITHUB_TOKEN", githubToken)
      .withSecretVariable("HEX_API_KEY", hexApiKey)
      .withEnvVariable("ACTOR", actor)
      .withEnvVariable("PACKAGE_VERSION", packageVersion)
      .withExec(["gh", "auth", "setup-git"])
      .withExec(["gh", "run", "download", runID, "--dir", "/artifacts", "--repo", repositorySlug])
      .withExec(["git", "config", "user.name", actor])
      .withExec(["git", "config", "user.email", actor + "@users.noreply.github.com"])
      .withExec([
        "sh",
        "-c",
        """
        set -eu
        {
          printf '%%{\n'
          find /artifacts -name '*.tar.gz' -type f | sort | while read -r artifact; do
            hash="$(shasum --algorithm 256 "$artifact" | awk '{ print $1 }')"
            printf '  "%s" => "sha256:%s",\n' "$(basename "$artifact")" "$hash"
          done
          printf '}\n'
        } > checksum.exs
        """,
      ])
      .withExec(["git", "add", "checksum.exs"])
      .withExec(["git", "commit", "--message", "Update checksums"])
      .withExec(["git", "tag", "v" + packageVersion, "--message", "Tagging v" + packageVersion + " release"])
      .withExec(["git", "push", "origin", "HEAD:" + baseRefName, "v" + packageVersion])
      .withExec([
        "sh",
        "-c",
        "find /artifacts -name '*.tar.gz' -type f -print0 | xargs -0 gh release create \"v${PACKAGE_VERSION}\" --repo " + repositorySlug,
      ])
      .withExec(["mix", "local.hex", "--force"])
      .withExec(["mix", "do", "deps.get", "+", "deps.compile"])
      .withExec(["mix", "hex.publish", "package", "--yes"])
  }

  let sourceTree(ref: String!, githubToken: Secret!): Directory! {
    git(url: repositoryURL, httpAuthToken: githubToken).ref(ref).tree(discardGitDir: true)
  }

  let sourceTreeWithGit(ref: String!, githubToken: Secret!): Directory! {
    git(url: repositoryURL, httpAuthToken: githubToken).ref(ref).tree(discardGitDir: false)
  }

  let latestLibpdfiumTag: String! {
    container
      .from(alpineImage)
      .withExec(["apk", "add", "coreutils"])
      .withNewFile("/tags", git(url: pdfiumBinariesURL).tags(patterns: ["refs/tags/chromium/*", "chromium/*"]).join("\n"))
      .withExec(["sh", "-c", "sed 's#^refs/tags/##' /tags | sort --version-sort | tail --lines 1"])
      .stdout
      .trimSpace
  }

  let nextPatchVersion(version: String!): String! {
    container
      .from(alpineImage)
      .withNewFile("/VERSION", version)
      .withExec(["awk", "-F.", "{ printf \"%s.%s.%s\", $1, $2, $3 + 1 }", "/VERSION"])
      .stdout
      .trimSpace
  }

  let githubCLI(githubToken: Secret!): Container! {
    container
      .from(alpineImage)
      .withExec(["apk", "add", "git", "github-cli"])
      .withSecretVariable("GH_TOKEN", githubToken)
      .withSecretVariable("GITHUB_TOKEN", githubToken)
  }

  let testScript: String! {
    """
    defmodule PDFium.NIF do
      @on_load :load_nif

      def load_nif do
        :erlang.load_nif(~c"./pdfium_nif", 0)
      end

      def load_document(_filename), do: :erlang.nif_error(:nif_not_loaded)

      def close_document(_document), do: :erlang.nif_error(:nif_not_loaded)

      def get_page_count(_document), do: :erlang.nif_error(:nif_not_loaded)

      def get_page_bitmap(_document, _page_number, _dpi), do: :erlang.nif_error(:nif_not_loaded)
    end

    {:ok, ref} = PDFium.NIF.load_document("./test.pdf")
    {:ok, pages} = PDFium.NIF.get_page_count(ref)

    IO.inspect(pages, label: "pages")
    """
  }

  let testPdf: String! {
    """
    %PDF-1.0
    1 0 obj<</Type/Catalog/Pages 2 0 R>>endobj
    2 0 obj<</Type/Pages/Kids[3 0 R 4 0 R]/Count 2>>endobj
    3 0 obj<</Type/Page/Parent 2 0 R>>endobj
    4 0 obj<</Type/Page/Parent 2 0 R>>endobj
    xref
    0 5
    0000000000 65535 f
    0000000009 00000 n
    0000000053 00000 n
    0000000102 00000 n
    0000000148 00000 n
    trailer<</Size 5/Root 1 0 R>>
    startxref
    194
    %%EOF
    """
  }

  let withBuildTools(base: Container!, abi: String!): Container! {
    if (abi == "glibc") {
      base
        .withExec(["apt", "update"])
        .withExec(["apt", "install", "build-essential", "tar", "--yes"])
    } else if (abi == "musl") {
      base
        .withExec(["apk", "add", "build-base", "tar", "coreutils"])
    } else {
      raise "unsupported abi: " + abi
    }
  }

  let withTestImage(platformName: String!, abi: String!): Container! {
    if (abi == "glibc") {
      container(platform: platformName)
        .from(glibcImage)
        .withExec(["apt", "update"])
        .withExec(["apt", "install", "tar", "--yes"])
    } else if (abi == "musl") {
      container(platform: platformName)
        .from(muslImage)
        .withExec(["apk", "add", "tar"])
    } else {
      raise "unsupported abi: " + abi
    }
  }
}
